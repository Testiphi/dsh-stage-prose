{
  "name": "dsh-stage-prose",
  "version": "1.0.0-rc.3",
  "type": "module",
  "description": "Live, non-intrusive progress updates every N silent steps during long DeepSeek Harness tasks, with auto-folding on completion and Timeline coordination.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "core",
    "client.js",
    "cordis.patch.yml",
    "defaults",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "compat/ledger.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Testiphi/dsh-stage-prose.git"
  },
  "homepage": "https://github.com/Testiphi/dsh-stage-prose#readme",
  "bugs": {
    "url": "https://github.com/Testiphi/dsh-stage-prose/issues"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "progress-updates",
    "progress-narration",
    "stage-prose",
    "step-progress",
    "live-status",
    "long-tasks",
    "auto-fold",
    "agent-workflow"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs && node --test test/config.mjs test/contract.mjs test/settings-api.mjs",
    "test:settings-web": "node test/settings-web.mjs",
    "prepack": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
